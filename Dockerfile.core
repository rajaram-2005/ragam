# Lightweight, dependency-free Node runtime for the existing online Core.
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    AETHERIS_CORE_HOST=0.0.0.0 \
    AETHERIS_CORE_PORT=8790 \
    AETHERIS_ONLINE_DATA_DIR=/var/lib/ragam/online

WORKDIR /app
COPY services/core/src ./services/core/src
RUN mkdir -p /var/lib/ragam/online \
    && chown -R node:node /var/lib/ragam

USER node
EXPOSE 8790
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8790/api/health').then(r => process.exit(r.status === 200 ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "services/core/src/server.mjs"]
