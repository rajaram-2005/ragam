{
  "name": "ragam-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Ragam local desktop app for Windows, macOS and Linux",
  "homepage": "https://github.com/rajaram-2005/ragam",
  "main": "main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "start": "npm run build:web && electron .",
    "build:installer": "npm run build:web && electron-builder",
    "smoke": "node scripts/smoke-packaged.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "build": {
    "appId": "ai.ragam.desktop",
    "productName": "Ragam",
    "asar": true,
    "files": [
      "main.mjs",
      "local-server.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../services/core/src",
        "to": "core/src"
      }
    ],
    "extraFiles": [
      {
        "from": "../../docs",
        "to": "docs"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "Ragam-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "Ragam-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "Ragam maintainers",
      "artifactName": "Ragam-${version}-Linux-${arch}.${ext}"
    }
  }
}
