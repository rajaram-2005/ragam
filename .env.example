# ACTIVE ONLINE-ONLY PRODUCT (Phase 2). Export these to the Core process.
# Provider URL and gateway key are configured in the authenticated Provider Settings UI.
AETHERIS_ONLINE_DATA_DIR=.aetheris-data/online
# Exact internal gateway origins allowed by the operator. Empty requires public HTTPS.
AETHERIS_LITELLM_TRUSTED_ORIGINS=
# Secure cookies default on. Set false ONLY for http:// local development.
AETHERIS_COOKIE_SECURE=true
# Sign-in is an account: an email address and a password, created on the sign-up page.
# The first account created on an installation becomes its owner and is the only one
# that can change the gateway connection; later accounts are members. This caps how many
# accounts an open sign-up page can create.
AETHERIS_MAX_ACCOUNTS=64
# Password resets cannot be emailed: this product has no mail transport. A single-use
# code is always written to password-resets.json inside the online data directory
# (mode 0600). Set true to ALSO print that code on the Core console — do not enable it
# where stdout is collected into logs anybody can read.
AETHERIS_PRINT_RESET_CODES=false
# AETHERIS_CORE_HOST and AETHERIS_CORE_PORT below also configure the online entry point.
# All other offline/training variables below belong to retained legacy code, not npm run core.

# Aetheris Omni — configuration reference
#
# Copy to .env (gitignored) or export these in the environment that starts the core
# service. Every value below is the DEFAULT; nothing here is required to boot.
#
#   cp .env.example .env
#   node services/core/src/server.mjs
#
# Two rules the loader enforces on its own:
#   - A blank or invalid AETHERIS_RUNTIME_POLICY fails safe to strict_offline and
#     records a warning. It never fails open.
#   - Any VITE_*(KEY|TOKEN|SECRET|PASSWORD) variable is reported as a warning,
#     because Vite ships VITE_* into the browser bundle. Secrets belong server-side.
#
# Credentials may be given directly or as a path via the matching *_FILE variable.
# Prefer *_FILE in containers so the secret never appears in the process
# environment or in a crash dump.


# --- runtime policy ---------------------------------------------------------
# strict_offline  external egress is blocked at the fetch layer; loopback runtimes
#                 (Ollama, llama.cpp) stay reachable. This is the default.
# hybrid          only allowlisted hosts, and only for data classified at or below
#                 AETHERIS_EXTERNAL_DATA_CEILING.
# online_enabled  allowlisted hosts, no per-request classification ceiling.
AETHERIS_RUNTIME_POLICY=strict_offline

# Highest data classification that may leave the machine in hybrid mode:
# public | internal | confidential | restricted
AETHERIS_EXTERNAL_DATA_CEILING=internal

# Comma-separated hostnames. Exact-host matching; no wildcards, no suffix matching.
# In strict_offline these are ignored and everything external is blocked (the loader
# warns you if you set both).
#
# The single entry '*' means "any external host". It exists because otherwise
# "fully online" was not expressible: online_enabled relaxes the data-classification
# gate but the egress guard still consulted this list, so with the list empty
# online_enabled blocked every external host exactly like strict_offline did.
#
# '*' is never honoured under strict_offline -- that check runs first.
# '*' is an exact entry, not a glob: '*.example.com' still matches nothing.
#
# Two combinations, both legitimate and not the same thing:
#   AETHERIS_ONLINE_ALLOWLIST=*  + AETHERIS_RUNTIME_POLICY=hybrid
#       Fully online, data ceiling still enforced. Sensitive text still needs
#       explicit per-request authorization. Use this by default.
#   AETHERIS_ONLINE_ALLOWLIST=*  + AETHERIS_RUNTIME_POLICY=online_enabled
#       Fully online AND data classification bypassed, so text classified up to
#       'restricted' may be sent to any host. The loader warns about this pair
#       specifically; it is not the same decision as the one above.
AETHERIS_ONLINE_ALLOWLIST=
# LAN allowlist is ignored under strict_offline. LAN inference is remote, not on-device.
AETHERIS_LOCAL_ALLOWLIST=


# --- core service -----------------------------------------------------------
AETHERIS_CORE_HOST=0.0.0.0
AETHERIS_CORE_PORT=8790
# Where SQLite metadata, generated media and the audit ledger live.
AETHERIS_DATA_DIR=./.aetheris-data
# CORS. Empty means same-origin only. Setting * must be a deliberate choice.
AETHERIS_ALLOWED_ORIGIN=


# --- local model runtimes ---------------------------------------------------
# Loopback by default so they remain reachable under strict_offline.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434

LLAMACPP_ENABLED=false
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_RUNTIME=llama.cpp
# LLAMACPP_API_KEY=
# LLAMACPP_API_KEY_FILE=/run/secrets/llamacpp_key

# Optional local embedding model id, used by the knowledge pipeline when set.
# Aetheris Lite's trained retriever is the default ranker otherwise (BM25 + dual
# encoder); see docs/06-benchmarks.md.
AETHERIS_EMBEDDING_MODEL=


# --- media pipeline ---------------------------------------------------------
# No image or video runtime ships in this build: image and video requests are
# refused and recorded rather than substituted. The budgets below bound the work
# any future provider is allowed to do; cancellation aborts the request.
AETHERIS_MEDIA_CONCURRENCY=1
AETHERIS_IMAGE_TIMEOUT_MS=300000
AETHERIS_VIDEO_TIMEOUT_MS=600000


# --- private knowledge pipeline ---------------------------------------------
AETHERIS_CHUNK_TARGET=1200
AETHERIS_CHUNK_MAX=2000
AETHERIS_CHUNK_OVERLAP=160


# --- plugins: publisher signatures ------------------------------------------
# A file of PEM public keys this host has chosen to trust, each labelled by hand.
# Key ids are derived from the keys on load, so a file whose ids disagree with its
# keys cannot make one key look like another. Nothing is ever fetched: a key is
# trusted because someone put it in this file.
#   id:<server id>          e.g. id:acme.repo-inspector
#   origin:<scheme://host>  e.g. origin:https://plugins.example.com
# A signature proves who published a manifest, not that the code is safe.
AETHERIS_TRUST_STORE=./.aetheris-data/trusted-keys.json
# Refuse unsigned plugin manifests outright. Off by default: a host that has not
# set up a trust store has no basis on which to require a signature.
AETHERIS_PLUGIN_REQUIRE_SIGNATURE=false


# --- MCP: server allowlist --------------------------------------------------
# Permitted servers, comma separated, matched exactly:
#   id:<server id>              a specific server
#   origin:<scheme://host:port> any server whose endpoint is on that origin
# Empty means unrestricted, and the service reports it that way. There is no
# wildcard and no suffix matching, so 'example.com' does not admit
# 'example.com.evil.net'. An entry that cannot be parsed stops startup.
AETHERIS_MCP_ALLOWLIST=


# --- God Core orchestration -------------------------------------------------
AETHERIS_GODMODE_ENABLED=true
# Hard budgets. Exceeding one ends the task as `partial` with the reason recorded,
# never as a silent success.
AETHERIS_GODMODE_MAX_STEPS=12
AETHERIS_GODMODE_MAX_MS=300000


# --- Aetheris Fabric (training / evaluation service) ------------------------
# Separate Python service on its own port. Disabled by default: the core does not
# depend on it, and reports the stages it cannot run without weights or a GPU.
AETHERIS_FABRIC_ENABLED=false
AETHERIS_FABRIC_URL=http://127.0.0.1:8791


# --- web app (apps/web, development only) -----------------------------------
# Not read by the core service. The dev server proxies /api to AETHERIS_CORE_URL,
# so browser code never contains a backend host.
WEB_PORT=5173
AETHERIS_CORE_URL=http://127.0.0.1:8790

# Optional operator-owned, versioned catalog-source JSON; no remote refresh at startup.
# Source credentials are read from tokenFile paths, never sent to the browser.
# AETHERIS_MODEL_CATALOG_FILE=/absolute/path/to/catalog-sources.json
