# Build the Vite frontend, then serve its static output with an unprivileged-port
# Caddy listener. The edge Caddy service handles TLS and /api proxying.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM caddy:2-alpine
RUN addgroup -S -g 10001 caddy-web \
    && adduser -S -D -H -u 10001 -G caddy-web caddy-web
COPY deploy/Web.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
ENV HOME=/tmp \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data
USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/healthz"]
